    "description": "Systeme de variantes de monstres (prefix, elite, boss)",
    "_refactor_2026_08": {
      "status": "en_transition",
      "direction": "Les stats_mult de ce fichier DOUBLONNENT config/monster_scaling_model.json (pivot stats derivees 2026-07-31). Modele cible = BASE(sprite) x NIVEAU(level_range) x TIER(menace) x AFFIXE-RARETE(prefix) x ETOILES(pack), stats 100% derivees.",
      "source_unique_stats": {
        "tier_mult (fodder..boss)": "config/monster_scaling_model.json -> tier_multipliers (PAS elite_variant/boss_variant.stats_mult ci-dessous)",
        "rarite_mult (normal/magic/rare/champion)": "config/monster_scaling_model.json -> rarity_multipliers (PAS prefix_variants.stats_mult ci-dessous)"
      },
      "prefix_devient_rarete": "corrupted/angry/armored/giant/swift = saveurs nommees des tiers magic/rare/champion. Gardent leur 'special'; le stat-mult vient de rarity_multipliers. Ne plus lire prefix_variants.stats_mult au runtime.",
      "species_families_collapse": "species_families = entites distinctes par stade de vie = cause de l'inflation 177 ids. A collapser: 1 base + level_range, l'alpha/geant = affixe champion (sprite agrandi + tint). Retombe vers ~74 sprites reels (voir memoire project_monster_affix_refactor).",
      "elite_boss_variant": "Garder size_mult/xp/gold/loot/phases/respawn/special_abilities. RETIRER stats_mult (source = tier_multipliers).",
      "conserves_tels_quels": "star_system (compo de pack) + size_by_danger (taille visuelle) = orthogonaux, aucun doublon."
    }
  },
