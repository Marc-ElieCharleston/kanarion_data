  "_meta": {
    "version": "3.0",
    "last_updated": "2026-03-04",
    "description": "Panoplies (sets d'équipement) - Système de rangs universel. Chaque set existe à tous les niveaux, le rang monte tous les 20 niveaux.",
    "total_sets": 25,
    "rank_system": {
      "_comment": "Dofus-style: mêmes sets à tous les niveaux, rang = palier de puissance. Les bonus listés dans chaque set sont les valeurs Rang 2 (base x1.0). Les autres rangs appliquent le multiplicateur.",
      "rang_1": { "level_range": [1, 19], "stat_multiplier": 0.5, "name_fr": "Rang 1 — Apprenti", "name_en": "Rank 1 — Apprentice" },
      "rang_2": { "level_range": [20, 39], "stat_multiplier": 1.0, "name_fr": "Rang 2 — Confirmé", "name_en": "Rank 2 — Adept" },
      "rang_3": { "level_range": [40, 59], "stat_multiplier": 1.5, "name_fr": "Rang 3 — Expert", "name_en": "Rank 3 — Expert" },
      "rang_4": { "level_range": [60, 100], "stat_multiplier": 2.0, "name_fr": "Rang 4 — Maître", "name_en": "Rank 4 — Master" }
    },
    "rank_formula": "final_bonus = floor(base_bonus × rank_multiplier). Ex: Kesher 2p lifesteal 5 → R1: 2, R2: 5, R3: 7, R4: 10",
    "equipment_slots": [
      { "id": "helmet", "name_fr": "Casque", "name_en": "Helmet" },
      { "id": "necklace", "name_fr": "Collier", "name_en": "Necklace" },
