      { "id": "weapon", "name_fr": "Arme", "name_en": "Weapon" }
    ],
    "min_level_by_size": {
      "_comment": "Level minimum pour commencer a looter un set selon son nombre de pieces",
      "2": 5,
      "4": 10,
      "6": 15,
      "8": 30
    },
    "notes": {
      "bonuses_cumulative": "Les bonus 2p/4p/6p/8p s'additionnent",
      "armor_types": "Implicite via stats: light (MAG), medium (ATK/Crit), heavy (DEF/HP)",
      "reloot": "Chaque rang doit etre farm separement. Le joueur garde l'ancien stuff en attendant de completer le rang suivant."
    }
  },

