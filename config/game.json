  "combat_grids": {
    "_comment": "Grilles de combat dynamiques - 4x5 standard partout sauf tutorial",
    "default": "4x5",
    "playtest_mode": false,
    "playtest_grids": ["4x5"],
    "available": {
      "4x5": {
        "rows": 4,
        "cols": 5,
        "total_slots": 20,
        "description": "Standard grid (4 rows × 5 cols) - all combat types"
      },
      "2x5": {
        "rows": 2,
        "cols": 5,
        "total_slots": 10,
        "description": "Compact grid for tutorial/small encounters"
      }
    },
    "layout": {
      "_comment": "Isometric projection - Canaan Online style. Enemy uses col_mirrored = (cols-1)-col",
      "_formula": "anchor = team_center - ((cols-1)/2)*axis_col - ((rows-1)/2)*axis_row; pos = anchor + col*axis_col + row*axis_row",
      "axis_col": {"x": 61, "y": 52},
      "axis_row": {"x": 66, "y": -39},
      "team_center_player": {"x": -145, "y": 70},
      "team_center_enemy": {"x": 115, "y": -75}
    },
    "usage": {
      "open_world": "4x5",
      "dungeon": "4x5",
      "pvp_arena": "4x5",
      "boss_fight": "4x5",
      "tutorial": "2x5",
      "playtest": "4x5"
    },
    "notes": "4x5 (4 rows x 5 cols) standardise partout — seul le tutorial reste en 2x5"
  },

