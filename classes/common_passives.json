  "_meta": {
    "version": "3.2",
    "last_updated": "2026-05-13",
    "description": "Common passives available to all classes — 18 passives, max 10 levels each. Mix flat+percent: flat gives early impact, percent scales late. Stats use DB-canonical keys.",
    "budget_note": "100 points to distribute across 18 common + 5 class + 3 subclass passives = 26 total, max 10 each (260 levels to max all = 38% reachable). Forces build choices.",
    "stat_application_notes": {
      "hp_regen": "out-of-combat only by design (combat HP regen via skills/heals only)",
      "tenacity": "applied in combat (status_manager) — cap 50%"
    },
    "intentional_overlaps": {
      "effect_chance": "appears in p_common_precision (+0.2/lvl) AND p_common_focus (+0.6/lvl) — opt-in stacking for debuff specialists, max combined +8 at lvl 10",
      "tenacity": "appears in p_common_tenacity (+0.5/lvl) AND p_common_safeguard (+0.25/lvl) — opt-in stacking for control-resistance specialists, max combined +7.5% at lvl 10"
    }
  },
