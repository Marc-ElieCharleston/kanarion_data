#!/bin/bash
# Pre-commit hook : verifie que content_hash decrit bien ce qui va etre commite.
# Installation : cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# POURQUOI IL DELEGUE A PYTHON
# ----------------------------
# L'ancienne version calculait le hash avec `find ... | cat`, donc sur les
# fichiers du DISQUE. Sous Windows git convertit les fins de ligne a
# l'extraction : le 2026-09-28, 51 fichiers sur 123 etaient en CRLF sur le disque
# et en LF dans l'index. Ce hook validait donc un hash que la CI Linux refusait,
# et refusait celui qu'elle attendait. Sur ce poste, aucun commit de data ne
# pouvait satisfaire les deux.
#
# scripts/hash_content.py lit les octets de l'INDEX, ce qui donne le meme
# resultat qu'une extraction Linux, sur toutes les plateformes.

set -e
cd "$(git rev-parse --show-toplevel)"

# Y a-t-il du JSON de gameplay dans ce commit ?
STAGED_JSON=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep '\.json$' \
  | grep -v 'kanarion-editor/' \
  | grep -v '^scripts/' \
  | grep -v '_meta/version.json' \
  | grep -v '_meta/statistics.json' \
  | grep -v '_meta/index.json' \
  | grep -v '_meta/changelog.json' \
  | grep -v '_meta/ideas_to_integrate.json' \
  || true)

if [ -z "$STAGED_JSON" ]; then
  exit 0
fi

if ! command -v python > /dev/null 2>&1; then
  echo "ERREUR : python est introuvable, le content_hash ne peut pas etre verifie." >&2
  exit 1
fi

if python scripts/hash_content.py --check; then
  exit 0
fi

cat >&2 <<'AIDE'

content_hash perime : du JSON de gameplay est dans ce commit mais le hash ne le
decrit pas.

Dans cet ordre, L'ORDRE COMPTE (le script lit l'index, pas le disque) :

    git add .
    python scripts/hash_content.py
    git add _meta/version.json

AIDE
exit 1
