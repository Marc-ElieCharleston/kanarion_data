  "sources": {
    "char_level": {
      "scope": "character",
      "from": "characters.level"
    },
    "char_stat_points_spent": {
      "scope": "character",
      "from": "SUM(characters.stat_allocations)"
    },
    "char_skill_points_spent": {
      "scope": "character",
      "from": "SUM(characters.skill_allocations)"
    },
    "char_subclass_chosen": {
      "scope": "character",
      "from": "characters.subclass_id non vide -> 1"
    },
    "quests_completed": {
      "scope": "character",
      "from": "COUNT(character_completed_quests)"
    },
    "quests_set_completed": {
      "scope": "character",
      "from": "COUNT(character_completed_quests IN params.quests)"
    },
    "arena_matches": {
      "scope": "character",
      "from": "COUNT(pvp_match_participants JOIN pvp_matches mode LIKE 'arena_%')"
    },
    "arena_wins": {
      "scope": "character",
      "from": "idem, won = true"
    },
    "arena_losses": {
      "scope": "character",
      "from": "idem, won = false et match non nul (winner_team non NULL)"
    },
    "arena_matches_2v2": {
      "scope": "character",
      "from": "idem, mode = 'arena_2v2'"
    },
    "arena_matches_4v4": {
      "scope": "character",
      "from": "idem, mode = 'arena_4v4'"
    },
    "arena_best_win_streak": {
      "scope": "character",
      "from": "MAX(pvp_ratings.best_win_streak), modes arena_%"
    },
    "familiar_hatched": {
      "scope": "account",
      "from": "COUNT(familiars du compte hors cadeaux familiar_gifts) : la recuperation d'un oeuf supprime la ligne d'incubation"
    },
    "familiar_rare_plus": {
      "scope": "account",
      "from": "COUNT(familiars rarity IN rare, epic, legendary)"
    },
    "familiar_epic_plus": {
      "scope": "account",
      "from": "COUNT(familiars rarity IN epic, legendary)"
    },
    "familiar_legendary": {
      "scope": "account",
      "from": "COUNT(familiars rarity = legendary)"
    },
    "familiar_distinct_roles": {
      "scope": "account",
      "from": "COUNT(DISTINCT familiars.role)"
    },
    "familiar_collection": {
      "scope": "account",
      "from": "COUNT(familiars), compte"
    }
  },
